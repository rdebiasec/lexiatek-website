# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60

# HubSpot Private App token (Settings → Integrations → Private Apps)
HUBSPOT_ACCESS_TOKEN=
# true = no llama HubSpot; simula create/search en memoria
HUBSPOT_DRY_RUN=true

# Costos / hard stop de conversación
USD_TO_COP=4100
AGENT_MAX_TOTAL_TOKENS=30000

# API
PORT=8787
CORS_ORIGINS=http://localhost:5195,http://127.0.0.1:5195,https://rdebiasec.github.io,https://lexiatek.com
NOTIFY_EMAIL=ricardo.debiase@dbx-solutions.com

# Panel admin: SOLO Authorization Bearer (nunca query string). Obligatorio en prod.
USAGE_ADMIN_TOKEN=
# Solo local/smoke: permite arrancar sin token fuerte
ALLOW_INSECURE_DEFAULTS=true

# Rate limits /v1/chat por IP
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_DAY=200

# Sesiones en memoria
SESSION_MAX_CONVERSATIONS=500
SESSION_TTL_SECONDS=3600
SESSION_MAX_TURNS=40

# Minimización CRM
HUBSPOT_NOTE_MAX_CHARS=800
HUBSPOT_RESUMEN_MAX_CHARS=500

# Persistencia usage (en Render: disco /var/data)
USAGE_STORE_PATH=./data/usage.jsonl

# WhatsApp Cloud API — gates de deployment final (firma + verify)
# WHATSAPP_VERIFY_TOKEN=
# META_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
