# Formspree form ID — create a form at https://formspree.io and paste YOUR_FORM_ID
# from https://formspree.io/f/YOUR_FORM_ID. Public in the client bundle — harden spam in Formspree.
VITE_FORMSPREE_FORM_ID=

# Base path for GitHub Pages without custom domain (e.g. /lexiatek-website/). Use / with custom domain.
# VITE_BASE_PATH=/
