# HubSpot Forms API (create form in Starter; paste portal + form GUID)
# https://knowledge.hubspot.com/forms/create-forms
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_ID=

# Intake widget API (Render prod URL). Local default: http://127.0.0.1:8787
# VITE_INTAKE_API_URL=https://lexiatek-intake-api.onrender.com

# WhatsApp CTA — leave empty until number is ready (button shows “próximamente”)
# VITE_WHATSAPP_URL=https://wa.me/57XXXXXXXXXX

# Base path for GitHub Pages without custom domain (e.g. /lexiatek-website/).
# When CNAME/custom domain lexiatek.com is live, use /
# VITE_BASE_PATH=/
